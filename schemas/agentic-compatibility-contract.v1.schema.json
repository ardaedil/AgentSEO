{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentseo.dev/schemas/agentic-compatibility-contract.v1.schema.json",
  "title": "AgentSEO Agentic Compatibility Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "intent", "initial_state", "assertions", "related_tools", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "intent": {"type": "string", "minLength": 1},
    "initial_state": {
      "type": "object",
      "oneOf": [
        {"required": ["fixture"], "properties": {"fixture": {"type": "string"}}, "additionalProperties": false},
        {"required": ["state"], "properties": {"state": {"type": "object"}}, "additionalProperties": false}
      ]
    },
    "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}},
    "invariants": {"type": "array", "items": {"$ref": "#/$defs/assertion"}, "default": []},
    "forbidden_actions": {"type": "array", "items": {"type": "string"}, "default": []},
    "required_actions": {"type": "array", "items": {"type": "string"}, "default": []},
    "behavior": {"type": "object", "properties": {"clarification": {"enum": ["required", "not_required"]}}, "additionalProperties": false},
    "budgets": {"type": "object", "properties": {"max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 30}}, "additionalProperties": false},
    "related_tools": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "categories": {"type": "array", "items": {"type": "string"}},
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "evaluator_version": {"type": "string"}
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "equals": {},
        "not_equals": {},
        "exists": {"type": "boolean"},
        "unchanged": {"const": true}
      },
      "oneOf": [
        {"required": ["equals"]},
        {"required": ["not_equals"]},
        {"required": ["exists"]},
        {"required": ["unchanged"]}
      ],
      "additionalProperties": false
    }
  }
}
